---
import { getCollection } from 'astro:content';

import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { profile } from '../data/profile';
import { href } from '../lib/url';

// draft: true の作品は本番では出さない。開発中（astro dev）では確認したいので出す
const works = (await getCollection('works', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

// 空文字のリンクは表示しない（公開したくない連絡先を profile.ts で空にできる作り）
const contactLinks = [
  { label: 'GitHub', value: profile.links.github, text: '@haruto3108' },
  { label: 'Email', value: profile.links.email ? `mailto:${profile.links.email}` : '', text: profile.links.email },
  { label: 'X', value: profile.links.x, text: profile.links.x.replace(/^https?:\/\//, '') },
  { label: 'Zenn', value: profile.links.zenn, text: profile.links.zenn.replace(/^https?:\/\//, '') },
].filter((link) => link.value !== '');
---

<Base description={profile.summary}>
  {/* ------------------------------------------------------------------ Hero */}
  <section class="hero">
    <div class="container">
      <div class="avatar-wrap">
        {/*
          アイコンはドット絵なので、320pxの原寸をそのまま置いて CSS で半分に出す。
          alt を空にしているのは、すぐ下にハンドル名が文字で続くため
          （読み上げで「haruto3108 のアイコン / haruto3108」と二重に聞こえるのを避ける）
        */}
        <img
          class="avatar"
          src={href(`/${profile.avatar}`)}
          width="320"
          height="320"
          alt=""
          fetchpriority="high"
        />

        {/*
          あいさつの吹き出し。両方のテキストをHTMLに出しておき、
          <html data-visit="return"> が付いているかどうかで CSS がどちらかを隠す。
          属性を付けるのは head のインラインスクリプト（描画前に走る）なので、
          2回目以降の訪問で「はじめまして」が一瞬見えることがない。
          JSが無い環境では属性が付かず、初回扱いの「はじめまして」が出る
        */}
        <p class="bubble">
          <span class="greet greet-first">はじめまして</span>
          <span class="greet greet-return">こんにちは</span>
        </p>
      </div>

      <h1 class="hero-name">{profile.name}</h1>
      <p class="hero-intro">{profile.intro}</p>
    </div>
  </section>

  {/* ----------------------------------------------------------------- Works */}
  <section id="works" class="section">
    <div class="container">
      {/*
        見出しは「WORKS」だけ。小見出しの見た目のまま h2 にしてあるのは、
        画面上は1語でも、文書構造としての見出しは残したいため
        （読み上げの見出しジャンプと検索エンジンの両方で効く）
      */}
      <h2 class="eyebrow">Works</h2>

      <div class="works" data-astro-prefetch="viewport">
        {works.map((work, index) => <WorkCard work={work} index={index} />)}
      </div>
    </div>
  </section>

  {/* ----------------------------------------------------------------- About */}
  <section id="about" class="section">
    <div class="container">
      {/* Works と同じく見出しは1語。見出しの文書構造は残したいので h2 のまま */}
      <h2 class="eyebrow">About</h2>

      {/* 古い順に並ぶ年表。順番は profile.ts の achievements に書いた順そのまま */}
      <ol class="timeline">
        {
          profile.achievements.map((item) => (
            <li class="timeline-item">
              <p class="timeline-meta">
                {/* datetime は機械向けに 'YYYY-MM' のまま。画面には 2024.07 と出す */}
                <time class="timeline-date" datetime={item.date}>
                  {item.date.replace('-', '.')}
                </time>
                {item.grade && <span class="timeline-grade">{item.grade}</span>}
              </p>
              <p class="timeline-title">{item.title}</p>
              {
                (item.team || item.url) && (
                  <p class="timeline-sub">
                    {item.team && <span class="timeline-team">チーム「{item.team}」</span>}
                    {/* 順位や合格を自分で確かめてもらうための証拠リンク */}
                    {item.url && (
                      <a class="timeline-link" href={item.url}>
                        {item.urlLabel || '結果を見る'} ↗
                      </a>
                    )}
                  </p>
                )
              }
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* --------------------------------------------------------------- Contact */}
  <section id="contact" class="section">
    <div class="container">
      <h2 class="eyebrow">Contact</h2>
      <p class="section-lead contact-lead">
        作ったものは GitHub で公開しています。ご連絡は下記からお願いします。
      </p>

      <ul class="contact">
        {
          contactLinks.map((link) => (
            <li class="contact-item">
              <span class="contact-label">{link.label}</span>
              <a href={link.value}>{link.text}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* ------------------------------------------------------------------- Hero */

  .hero {
    /*
      下の余白は 0 にして、Works 側の padding（--space-section）だけで間を作る。
      中身がアイコンと2行だけなので、両方から空けると間延びして見える
    */
    padding-block: clamp(2.5rem, 8vh, 4.5rem) 0;
    text-align: center;
  }

  /*
    アイコンの丸枠。吹き出しの位置の基準にもなるので position: relative を持たせる。
    枠からはみ出させたいので overflow は切らない
  */
  .avatar-wrap {
    position: relative;
    display: inline-block;
    margin-bottom: 1.5rem;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    /* アイコンの背景が透明なので、下地を敷かないと背景に溶ける */
    background: var(--bg-elev);
  }

  .avatar {
    /*
      320px の原寸をちょうど半分で出す。ドット絵は整数分の1でないと
      1ドットが2pxと3pxに割れてガタつくので、可変にせず固定値にしている
    */
    width: 160px;
    height: 160px;
    border-radius: 50%;
    /* 既定の補間を切って、ドットの輪郭を保つ */
    image-rendering: pixelated;
  }

  .bubble {
    position: absolute;
    bottom: 74%;
    left: 76%;
    margin: 0;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--border-strong);
    border-radius: 1.125rem;
    background: var(--bg-elev);
    box-shadow: var(--shadow);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.7;
    /* 短い挨拶なので折り返さない。折り返すと吹き出しの形が崩れる */
    white-space: nowrap;
    /* アイコンから生えてくるように見せる */
    transform-origin: bottom left;
    animation: bubble-in 0.45s cubic-bezier(0.18, 0.89, 0.32, 1.28) 0.3s both;
  }

  /* 吹き出しのしっぽ。小さい四角を45度回して、下辺の2辺だけ線を残す */
  .bubble::after {
    content: '';
    position: absolute;
    left: 1rem;
    bottom: -0.3rem;
    width: 0.55rem;
    height: 0.55rem;
    background: var(--bg-elev);
    border-right: 1px solid var(--border-strong);
    border-bottom: 1px solid var(--border-strong);
    transform: rotate(45deg);
  }

  /*
    スマホ幅では、既定の位置（アイコンの右上）のままだと
    「はじめまして」の分だけ画面右端をはみ出して横スクロールが出る。
    アイコンに重なる側へ寄せ、文字も一段小さくして収める
  */
  @media (width < 26rem) {
    .bubble {
      left: 58%;
      padding: 0.3rem 0.75rem;
      font-size: 0.8125rem;
    }
  }

  @keyframes bubble-in {
    from {
      opacity: 0;
      transform: translateY(0.4rem) scale(0.88);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /*
    あいさつの出し分け。既定は「はじめまして」で、
    2回目以降（head のスクリプトが data-visit="return" を付けたとき）だけ入れ替える。
    JSが無い環境では属性が付かないので、初回の挨拶が出る
  */
  .greet-return {
    display: none;
  }

  :global(:root[data-visit='return']) .greet-first {
    display: none;
  }

  :global(:root[data-visit='return']) .greet-return {
    display: inline;
  }

  .hero-name {
    margin: 0 0 0.625rem;
    /* GitHub のIDなので、等幅で出したほうが「ハンドル名」だと伝わる */
    font-family: var(--font-mono);
    font-size: clamp(1.625rem, 6vw, 2.25rem);
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .hero-intro {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--fg-muted);
    /*
      日本語は既定だと文字のどこででも改行されるので、320px 幅だと
      「…電子情報工学 / 科」と最後の1文字だけが次の行に落ちてしまう。
      keep-all で、空白を入れたところでだけ折り返すようにする
    */
    word-break: keep-all;
    /* keep-all のままだと、語が画面幅より長いときにはみ出す。そのときだけ折る */
    overflow-wrap: anywhere;
  }

  /* --------------------------------------------------------------- セクション */

  .section {
    padding-block: var(--space-section) 0;
  }

  .section-lead {
    max-width: var(--width-prose);
    margin: 0;
    color: var(--fg-muted);
  }

  /* 見出し（eyebrow）の直後に来るので、間隔をここで取る */
  .contact-lead {
    margin-top: 1.5rem;
  }

  .works {
    margin-top: 2rem;
    /* カードの区切り線が最後にも入ると床が抜けて見えるので、最後だけ下線を足して閉じる */
    border-bottom: 1px solid var(--border);
  }

  /* ------------------------------------------------------------------ About */

  /*
    実績の年表。項目ごとに左へ縦線を引き、その上に点を重ねている。
    線は項目の高さぶんだけ伸びるので、項目が増えても自然につながる
  */
  .timeline {
    max-width: var(--width-prose);
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .timeline-item {
    position: relative;
    padding-left: 1.75rem;
    padding-bottom: 1.75rem;
    border-left: 1px solid var(--border);
  }

  /* 最後の項目から下に線が垂れ下がらないよう、線だけ消して余白は残す */
  .timeline-item:last-child {
    padding-bottom: 0;
    border-left-color: transparent;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    /* 点の中心を線の上に乗せる（線幅1px ぶん左にずらす） */
    left: -0.3125rem;
    top: 0.4rem;
    width: 0.5625rem;
    height: 0.5625rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .timeline-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin: 0 0 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  .timeline-date {
    color: var(--accent);
    font-weight: 500;
  }

  .timeline-grade {
    color: var(--fg-faint);
  }

  .timeline-title {
    margin: 0;
    font-weight: 500;
    /* 「パソコン甲子園 モバイル部門 本戦出場」が変なところで折れないよう、
       空白の位置でだけ折り返す */
    word-break: keep-all;
    overflow-wrap: anywhere;
  }

  /* チーム名と証拠リンクの行。片方しか無いこともある */
  .timeline-sub {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    margin: 0.3rem 0 0;
    font-size: 0.875rem;
  }

  .timeline-team {
    color: var(--fg-muted);
  }

  .timeline-link {
    color: var(--accent);
    text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
    white-space: nowrap;
  }

  /* ---------------------------------------------------------------- Contact */

  .contact {
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    max-width: var(--width-prose);
  }

  .contact-item {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--border);
  }

  .contact-label {
    min-width: 5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--fg-faint);
    text-transform: uppercase;
  }
</style>

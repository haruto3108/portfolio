---
/**
 * 全ページ共通の外枠。<head> の中身・ヘッダー・フッターをここで持つ。
 */
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
import { href } from '../lib/url';

interface Props {
  /** ページ固有のタイトル。トップだけ省略して名前だけを出す */
  title?: string;
  /** 検索結果とSNSカードに出る説明文。120字程度まで */
  description: string;
}

const { title, description } = Astro.props;

const siteName = `${profile.name} | ポートフォリオ`;
const pageTitle = title ? `${title} | ${profile.name}` : siteName;

// Astro.site が未設定（ローカルの一部ケース）でも落ちないようにしておく
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* TODO: OG画像（1200x630）を public/og.png に置いたら、下の2行のコメントを外す */}
    {/* <meta property="og:image" content={`${Astro.site}og.png`} /> */}

    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />

    {/*
      テーマと「何回目の訪問か」の初期化。
      どちらも描画前に <html> の属性を決めておかないと、表示が一瞬入れ替わって見えてしまうので、
      ここだけは head 内のインラインスクリプトで同期的に実行する。
      （テーマ: OSがダークの人に白い画面が一瞬出る / あいさつ: 「はじめまして」が一瞬見える）
    */}
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.dataset.theme = saved;
          }
        } catch {
          // プライベートモードなどで localStorage が触れないことがある。
          // その場合は OS の設定（prefers-color-scheme）に任せればよい
        }

        try {
          // 2回目以降だけ data-visit="return" を付ける。
          // 属性が無い状態＝初回なので、JSが無い人にも「はじめまして」が出る
          if (localStorage.getItem('visited')) {
            document.documentElement.dataset.visit = 'return';
          } else {
            localStorage.setItem('visited', '1');
          }
        } catch {
          // 保存できない環境では毎回「はじめまして」になる。
          // 記録が残らない以上それが正しい挙動なので、何もしない
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <style>
      /* キーボード操作の人がヘッダーのリンクを飛ばして本文へ行けるようにする。
         普段は画面外に置き、フォーカスが当たったときだけ出す */
      .skip-link {
        position: fixed;
        top: 0.5rem;
        left: 0.5rem;
        z-index: 100;
        padding: 0.5rem 0.9rem;
        border-radius: var(--radius);
        background: var(--accent);
        color: var(--accent-fg);
        font-size: 0.875rem;
        text-decoration: none;
        transform: translateY(-150%);
      }

      .skip-link:focus-visible {
        transform: translateY(0);
      }
    </style>
  </body>
</html>

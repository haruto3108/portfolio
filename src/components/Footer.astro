---
import { profile } from '../data/profile';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container inner">
    <p class="copy">© {year} {profile.name}</p>
    <p class="built">
      Built with <a href="https://astro.build">Astro</a> ·
      <a href="https://github.com/haruto3108/portfolio">このサイトのソース</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-section);
    border-top: 1px solid var(--border);
    padding-block: 2rem;
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-faint);
  }

  .copy,
  .built {
    margin: 0;
  }
</style>

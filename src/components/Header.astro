---
/**
 * 上部に固定するヘッダー。ページ内移動のリンクとテーマ切り替えを持つ。
 */
import { profile } from '../data/profile';
import { href } from '../lib/url';

// 作品詳細ページから押されてもトップの該当位置に飛べるよう、
// 絶対パス（/#works）で書いている
const navItems = [
  { label: 'Works', path: '/#works' },
  { label: 'About', path: '/#about' },
  { label: 'Contact', path: '/#contact' },
];
---

<header class="header">
  <div class="container inner">
    <a class="brand" href={href('/')}>
      <span class="brand-name">{profile.name}</span>
      {/* 英字表記を別に持たせたときだけ添える。いまはハンドル名だけなので出ない */}
      {profile.nameLatin && <span class="brand-latin">{profile.nameLatin}</span>}
    </a>

    <nav aria-label="サイト内">
      <ul class="nav">
        {
          navItems.map((item) => (
            <li>
              <a href={href(item.path)}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/*
      テーマ切り替え。JSが無い環境では意味がないので hidden で置き、
      スクリプト側で外す（押しても何も起きないボタンを見せないため）
    */}
    <button id="theme-toggle" type="button" class="toggle" hidden aria-live="polite">
      <span class="visually-hidden">表示テーマを切り替える</span>
      <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"></path>
      </svg>
      <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
      </svg>
    </button>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--border);
    /* 下のコンテンツが透けて見えるとスクロール中に文字が重なって読みづらいので、
       ぼかしを掛けたうえで背景色をほぼ不透明にしている */
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(12px);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 3.75rem;
  }

  .brand {
    display: flex;
    flex-direction: column;
    margin-right: auto;
    text-decoration: none;
    line-height: 1.25;
  }

  .brand-name {
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .brand-latin {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--fg-faint);
  }

  .nav {
    display: flex;
    gap: clamp(0.75rem, 3vw, 1.75rem);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
  }

  .nav a {
    text-decoration: none;
    color: var(--fg-muted);
    transition: color 0.15s;
  }

  .nav a:hover {
    color: var(--fg);
  }

  /*
    320px 幅だと brand + nav + トグルが収まらず、トグルが画面外に出てしまう。
    文字と間隔を詰めて3つとも入るようにする
  */
  @media (width < 26rem) {
    .inner {
      gap: 0.625rem;
    }

    .brand-name {
      font-size: 0.875rem;
    }

    .nav {
      gap: 0.625rem;
      font-size: 0.75rem;
    }
  }

  .toggle {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-elev);
    color: var(--fg-muted);
    cursor: pointer;
  }

  .toggle:hover {
    color: var(--fg);
    border-color: var(--border-strong);
  }

  /* 今のテーマと逆側のアイコンだけ出す（押したらこうなる、を示す） */
  .icon-moon {
    display: none;
  }

  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }

  :global(:root[data-theme='dark']) .icon-sun {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-sun {
      display: block;
    }

    :global(:root:not([data-theme='light'])) .icon-moon {
      display: none;
    }
  }

  :global(:root[data-theme='light']) .icon-sun {
    display: none;
  }

  :global(:root[data-theme='light']) .icon-moon {
    display: block;
  }

  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) .icon-sun {
      display: none;
    }

    :global(:root:not([data-theme='dark'])) .icon-moon {
      display: block;
    }
  }
</style>

<script>
  const toggle = document.getElementById('theme-toggle');

  if (toggle) {
    // JSが動いた時点で初めて見せる
    toggle.hidden = false;

    toggle.addEventListener('click', () => {
      const root = document.documentElement;
      // 属性が無い＝OS任せの状態。いま実際に暗いかどうかを見てから反転させる
      const isDark = root.dataset.theme
        ? root.dataset.theme === 'dark'
        : window.matchMedia('(prefers-color-scheme: dark)').matches;
      const next = isDark ? 'light' : 'dark';

      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        // 保存できなくても、このページ内では切り替わっているので続行する
      }
    });
  }
</script>
